---
interface Props {
  size?: number;
  class?: string;
  alt?: string;
}

const { size = 40, class: className = "", alt = "EV Charging Station Nepal" } = Astro.props;
---

<img
  src="/logo.svg"
  alt={alt}
  width={size}
  height={size}
  class:list={["shrink-0", className]}
  decoding="async"
/>
