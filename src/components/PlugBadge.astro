---
import type { Plug } from "../lib/stations";
import { normalizePlugKind, plugDisplayLabel } from "../lib/plugs";

interface Props {
  plug: Pick<Plug, "plug" | "type" | "power" | "count" | "icon">;
  class?: string;
  showMeta?: boolean;
  size?: number;
  compact?: boolean;
}

const {
  plug,
  class: className = "",
  showMeta = true,
  size = 20,
  compact = false,
} = Astro.props;
const kind = normalizePlugKind(plug.plug || plug.icon);
const label = plugDisplayLabel(plug);
const meta = showMeta
  ? compact
    ? [plug.power, plug.type ? `(${plug.type})` : null].filter(Boolean).join(" · ")
    : [plug.power, plug.count ? `${plug.count}x` : null].filter(Boolean).join(" · ")
  : "";
---

{
  compact ? (
    <span
      class:list={[
        "inline-flex items-center gap-1.5 rounded-md border border-charge/20 bg-charge/10 px-2 py-0.5 font-mono text-[0.68rem] font-semibold text-charge uppercase",
        className,
      ]}
    >
      <span class="inline-flex text-charge">
        {
          kind === "ccs2" ? (
            <svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <rect x="1.5" y="1.5" width="29" height="29" rx="7" stroke="currentColor" stroke-width="1.5" opacity="0.35"></rect>
              <circle cx="16" cy="12.5" r="7" stroke="currentColor" stroke-width="1.6"></circle>
              <circle cx="12.2" cy="10.8" r="1.35" fill="currentColor"></circle>
              <circle cx="19.8" cy="10.8" r="1.35" fill="currentColor"></circle>
              <circle cx="16" cy="14.8" r="1.35" fill="currentColor"></circle>
              <circle cx="13.4" cy="16.6" r="0.9" fill="currentColor" opacity="0.75"></circle>
              <circle cx="18.6" cy="16.6" r="0.9" fill="currentColor" opacity="0.75"></circle>
              <circle cx="11.4" cy="13.6" r="0.75" fill="currentColor" opacity="0.55"></circle>
              <circle cx="20.6" cy="13.6" r="0.75" fill="currentColor" opacity="0.55"></circle>
              <rect x="9.2" y="21.2" width="5.2" height="6.2" rx="1.4" stroke="currentColor" stroke-width="1.4"></rect>
              <rect x="17.6" y="21.2" width="5.2" height="6.2" rx="1.4" stroke="currentColor" stroke-width="1.4"></rect>
            </svg>
          ) : kind === "gbt" ? (
            <svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <rect x="1.5" y="1.5" width="29" height="29" rx="7" stroke="currentColor" stroke-width="1.5" opacity="0.35"></rect>
              <circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="1.6"></circle>
              <circle cx="16" cy="16" r="2.1" fill="currentColor"></circle>
              <circle cx="16" cy="8.8" r="1.45" fill="currentColor"></circle>
              <circle cx="16" cy="23.2" r="1.45" fill="currentColor"></circle>
              <circle cx="8.8" cy="16" r="1.45" fill="currentColor"></circle>
              <circle cx="23.2" cy="16" r="1.45" fill="currentColor"></circle>
              <circle cx="10.9" cy="10.9" r="1.15" fill="currentColor" opacity="0.8"></circle>
              <circle cx="21.1" cy="10.9" r="1.15" fill="currentColor" opacity="0.8"></circle>
              <circle cx="10.9" cy="21.1" r="1.15" fill="currentColor" opacity="0.8"></circle>
              <circle cx="21.1" cy="21.1" r="1.15" fill="currentColor" opacity="0.8"></circle>
            </svg>
          ) : (
            <svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <rect x="1.5" y="1.5" width="29" height="29" rx="7" stroke="currentColor" stroke-width="1.5" opacity="0.35"></rect>
              <circle cx="16" cy="16" r="7.5" stroke="currentColor" stroke-width="1.6"></circle>
              <circle cx="16" cy="16" r="2" fill="currentColor"></circle>
            </svg>
          )
        }
      </span>
      <span>
        {label}
        {meta ? ` · ${meta}` : ""}
      </span>
    </span>
  ) : (
    <span
      class:list={[
        "inline-flex w-full items-center gap-3 rounded-2xl border border-line bg-ink/40 px-4 py-3 text-sm font-semibold uppercase text-paper",
        className,
      ]}
    >
      <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-charge/25 bg-charge/10 text-charge">
        {
          kind === "ccs2" ? (
            <svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <rect x="1.5" y="1.5" width="29" height="29" rx="7" stroke="currentColor" stroke-width="1.5" opacity="0.35"></rect>
              <circle cx="16" cy="12.5" r="7" stroke="currentColor" stroke-width="1.6"></circle>
              <circle cx="12.2" cy="10.8" r="1.35" fill="currentColor"></circle>
              <circle cx="19.8" cy="10.8" r="1.35" fill="currentColor"></circle>
              <circle cx="16" cy="14.8" r="1.35" fill="currentColor"></circle>
              <circle cx="13.4" cy="16.6" r="0.9" fill="currentColor" opacity="0.75"></circle>
              <circle cx="18.6" cy="16.6" r="0.9" fill="currentColor" opacity="0.75"></circle>
              <circle cx="11.4" cy="13.6" r="0.75" fill="currentColor" opacity="0.55"></circle>
              <circle cx="20.6" cy="13.6" r="0.75" fill="currentColor" opacity="0.55"></circle>
              <rect x="9.2" y="21.2" width="5.2" height="6.2" rx="1.4" stroke="currentColor" stroke-width="1.4"></rect>
              <rect x="17.6" y="21.2" width="5.2" height="6.2" rx="1.4" stroke="currentColor" stroke-width="1.4"></rect>
            </svg>
          ) : kind === "gbt" ? (
            <svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <rect x="1.5" y="1.5" width="29" height="29" rx="7" stroke="currentColor" stroke-width="1.5" opacity="0.35"></rect>
              <circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="1.6"></circle>
              <circle cx="16" cy="16" r="2.1" fill="currentColor"></circle>
              <circle cx="16" cy="8.8" r="1.45" fill="currentColor"></circle>
              <circle cx="16" cy="23.2" r="1.45" fill="currentColor"></circle>
              <circle cx="8.8" cy="16" r="1.45" fill="currentColor"></circle>
              <circle cx="23.2" cy="16" r="1.45" fill="currentColor"></circle>
              <circle cx="10.9" cy="10.9" r="1.15" fill="currentColor" opacity="0.8"></circle>
              <circle cx="21.1" cy="10.9" r="1.15" fill="currentColor" opacity="0.8"></circle>
              <circle cx="10.9" cy="21.1" r="1.15" fill="currentColor" opacity="0.8"></circle>
              <circle cx="21.1" cy="21.1" r="1.15" fill="currentColor" opacity="0.8"></circle>
            </svg>
          ) : (
            <svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <rect x="1.5" y="1.5" width="29" height="29" rx="7" stroke="currentColor" stroke-width="1.5" opacity="0.35"></rect>
              <circle cx="16" cy="16" r="7.5" stroke="currentColor" stroke-width="1.6"></circle>
              <circle cx="16" cy="16" r="2" fill="currentColor"></circle>
            </svg>
          )
        }
      </span>
      <span class="min-w-0">
        {label}
        {plug.type ? ` (${plug.type})` : ""}
      </span>
      {meta && <span class="ml-auto font-mono text-xs text-charge normal-case">{meta}</span>}
    </span>
  )
}
