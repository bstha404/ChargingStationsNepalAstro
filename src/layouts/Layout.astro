---
import "../styles/global.css";
import BrandLogo from "../components/BrandLogo.astro";
import ThemeToggle from "../components/ThemeToggle";
import MobileNav from "../components/MobileNav";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  keywords?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
}

const {
  title = "EV Charging Station Nepal — Find EV Charging Stations Near You",
  description = "Find EV charging stations across Nepal. Search the nearest EV charging station near me in Kathmandu, Pokhara, and highways—with AC/DC filters and directions.",
  canonical,
  image = "/og-image.svg",
  keywords,
  jsonLd,
  noindex = false,
  ogType = "website",
  ogTitle,
  ogDescription,
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, "") || "https://evchargingstationnepal.com";
const canonicalUrl = canonical
  ? canonical.startsWith("http")
    ? canonical
    : `${site}${canonical.endsWith("/") || canonical.includes(".") ? canonical : `${canonical}/`}`
  : new URL(Astro.url.pathname, site).toString();
const ogImage = image.startsWith("http") ? image : `${site}${image}`;
const shareTitle = ogTitle || title;
const shareDescription = ogDescription || description;

const organizationLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "EV Charging Station Nepal",
  url: site,
  logo: `${site}/logo.svg`,
  description:
    "Free map directory to find EV charging stations near you across Nepal—Kathmandu, Pokhara, NEA, Tata, and highway chargers.",
  areaServed: {
    "@type": "Country",
    name: "Nepal",
  },
  sameAs: [],
  contactPoint: {
    "@type": "ContactPoint",
    email: "hello@evchargingstationnepal.com",
    contactType: "customer support",
    availableLanguage: ["English"],
  },
};

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "EV Charging Station Nepal",
  url: site,
  description,
  inLanguage: "en-NP",
  publisher: {
    "@type": "Organization",
    name: "EV Charging Station Nepal",
  },
  potentialAction: {
    "@type": "SearchAction",
    target: `${site}/?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};

const jsonLdList = [
  organizationLd,
  websiteLd,
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];

const nav = [
  { href: "/stations/", label: "All Stations" },
//  { href: "/", label: "Map" },
  { href: "/cities/", label: "Cities" },
  { href: "/faq/", label: "FAQ" },
];
---

<!doctype html>
<html lang="en-NP">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta
      name="robots"
      content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"}
    />
    <meta name="googlebot" content={noindex ? "noindex,follow" : "index,follow"} />
    <meta name="author" content="EV Charging Station Nepal" />
    <meta name="geo.region" content="NP" />
    <meta name="geo.placename" content="Nepal" />
    <meta name="language" content="English" />
    <meta name="rating" content="general" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en-NP" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="EV Charging Station Nepal" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="EV Charging Station Nepal map — find EV charging stations near me across Nepal"
    />
    <meta property="og:locale" content="en_NP" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={shareDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content="EV Charging Station Nepal — nearest EV charging station finder"
    />
    <meta name="twitter:url" content={canonicalUrl} />

    <meta name="theme-color" content="#F2F5F2" />
    <meta name="color-scheme" content="light dark" />
    <meta name="format-detection" content="telephone=yes" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme = stored === "light" || stored === "dark" ? stored : "light";
          document.documentElement.setAttribute("data-theme", theme);
          document.documentElement.style.colorScheme = theme;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", theme === "light" ? "#F2F5F2" : "#0B0D0C");
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="author" type="text/plain" href="/humans.txt" />
    <link type="text/plain" rel="author" href="/llms.txt" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    {
      jsonLdList.map((item) => (
        <script type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-YK9GBJE0NL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-YK9GBJE0NL");
    </script>
  </head>
  <body class="min-h-screen bg-ink text-paper antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-charge focus:px-3 focus:py-2 focus:text-ink"
    >
      Skip to content
    </a>

    <header class="sticky top-0 z-40 border-b border-line/80 bg-ink">
      <div class="mx-auto flex max-w-[1280px] items-center justify-between gap-3 px-6 py-4">
        <a href="/" class="group flex min-w-0 items-center gap-3 no-underline">
          <BrandLogo size={40} class="h-10 w-10 shrink-0" />
          <span class="min-w-0">
            <span class="font-display block truncate text-base font-extrabold tracking-tight text-paper group-hover:text-charge sm:text-lg">
              EV Charging Station Nepal
            </span>
            <span class="mt-0.5 hidden text-[0.7rem] font-medium tracking-[0.08em] text-muted uppercase sm:block">
              Charging Stations Finder
            </span>
          </span>
        </a>
        <div class="flex shrink-0 items-center gap-2">
          <nav class="hidden items-center gap-1 text-sm font-semibold md:flex" aria-label="Primary">
            {
              nav.map((item) => (
                <a
                  href={item.href}
                  class="rounded-full px-3 py-2 text-muted no-underline transition-colors hover:bg-panel hover:text-charge"
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
          <ThemeToggle client:load />
          <MobileNav client:load />
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="mt-10 border-t border-line bg-footer">
      <div class="mx-auto grid max-w-[1280px] gap-8 px-6 py-12 sm:grid-cols-2 lg:grid-cols-4">
        <div class="lg:col-span-2">
          <a href="/" class="inline-flex items-center gap-3 no-underline">
            <BrandLogo size={44} class="h-11 w-11" />
            <p class="font-display text-xl font-bold text-paper">EV Charging Station Nepal</p>
          </a>
          <p class="mt-3 max-w-md text-sm leading-relaxed text-muted">
            A Nepal-focused directory of electric vehicle charging stations with search, filters,
            nearby sorting, and directions.
          </p>
        </div>
        <div>
          <p class="mb-3 text-xs font-semibold tracking-[0.08em] text-charge uppercase">Explore</p>
          <ul class="space-y-2 text-sm">
            <li><a href="/" class="text-muted no-underline hover:text-charge">Map search</a></li>
            <li><a href="/cities/" class="text-muted no-underline hover:text-charge">Cities</a></li>
            <li><a href="/stations/" class="text-muted no-underline hover:text-charge">All stations</a></li>
            <li><a href="/faq/" class="text-muted no-underline hover:text-charge">FAQ</a></li>
          </ul>
        </div>
        <div>
          <p class="mb-3 text-xs font-semibold tracking-[0.08em] text-charge uppercase">Legal</p>
          <ul class="space-y-2 text-sm">
            <li><a href="/about/" class="text-muted no-underline hover:text-charge">About</a></li>
            <li><a href="/contact/" class="text-muted no-underline hover:text-charge">Contact</a></li>
            <li><a href="/privacy/" class="text-muted no-underline hover:text-charge">Privacy Policy</a></li>
            <li><a href="/terms/" class="text-muted no-underline hover:text-charge">Terms of Use</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-line/70">
        <div class="mx-auto flex max-w-[1280px] flex-col gap-2 px-6 py-5 text-xs text-subtle sm:flex-row sm:items-center sm:justify-between">
          <p>© {new Date().getFullYear()} EV Charging Station Nepal. Data for informational use.</p>
          <p>Verify station availability before travel.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
