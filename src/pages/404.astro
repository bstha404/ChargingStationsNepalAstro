---
import "../styles/global.css";
---

<!doctype html>
<html lang="en-NP">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Station Not Found | EV Charging Station Nepal</title>
    <meta
      name="description"
      content="Looks like this charging point is offline or doesn't exist on EV Charging Station Nepal."
    />
    <meta name="robots" content="noindex,follow" />
    <meta name="theme-color" content="#050f05" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="error-404">
    <div class="error-404__grid" aria-hidden="true"></div>

    <main class="error-404__main">
      <img
        src="/logo.svg"
        alt="EV Charging Station Nepal"
        width="88"
        height="88"
        class="error-404__logo"
        decoding="async"
      />

      <div class="error-404__code" aria-hidden="true">
        <span class="error-404__code-outline">404</span>
        <span class="error-404__code-fill">404</span>
      </div>
      <h1 class="error-404__title">Station Not Found</h1>
      <p class="error-404__copy">
        Looks like this charging point is offline or doesn't exist. The route you're looking for has
        lost power.
      </p>

      <div class="error-404__badge">
        <span class="error-404__badge-dot" aria-hidden="true"></span>
        Station Offline
      </div>

      <div class="error-404__actions">
        <a href="/" class="error-404__btn error-404__btn--primary">Go to Home</a>
        <a href="/stations/" class="error-404__btn error-404__btn--ghost">Find a Station</a>
      </div>

      <nav class="error-404__links" aria-label="Helpful links">
        <a href="/">Charging Map</a>
        <a href="/contact/">Contact Us</a>
        <a href="/faq/">Support</a>
      </nav>
    </main>

    <svg
      class="error-404__mountains"
      viewBox="0 0 1440 220"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
        fill="#0a1a0c"
        d="M0 220V120L180 70L320 130L480 40L640 110L820 55L980 125L1120 65L1280 115L1440 80V220H0Z"
      ></path>
      <path
        fill="#0d2210"
        d="M0 220V155L220 110L390 160L560 95L760 150L940 105L1140 155L1320 120L1440 145V220H0Z"
      ></path>
      <circle cx="820" cy="58" r="3" fill="#8ee36a" opacity="0.85"></circle>
    </svg>

    <style>
      .error-404 {
        margin: 0;
        min-height: 100vh;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #050f05;
        color: #d7f5c8;
        font-family: var(--font-body);
      }

      .error-404__grid {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(88, 174, 55, 0.07) 1px, transparent 1px),
          linear-gradient(90deg, rgba(88, 174, 55, 0.07) 1px, transparent 1px);
        background-size: 48px 48px;
        mask-image: radial-gradient(ellipse at center, black 25%, transparent 75%);
        pointer-events: none;
      }

      .error-404__main {
        position: relative;
        z-index: 1;
        width: min(100%, 40rem);
        padding: 3rem 1.5rem 8rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .error-404__logo {
        width: 5.5rem;
        height: 5.5rem;
        margin-bottom: 0.75rem;
        filter: drop-shadow(0 0 18px rgba(142, 227, 106, 0.28));
        animation: float 3.6s ease-in-out infinite;
      }

      .error-404__code {
        position: relative;
        margin: 0.25rem 0 0.75rem;
        font-family: var(--font-display);
        font-size: clamp(5.5rem, 22vw, 9.5rem);
        font-weight: 800;
        line-height: 0.9;
        letter-spacing: -0.04em;
        user-select: none;
      }

      .error-404__code-outline {
        color: transparent;
        -webkit-text-stroke: 2.5px #8ee36a;
        text-shadow: 0 0 28px rgba(142, 227, 106, 0.25);
      }

      .error-404__code-fill {
        position: absolute;
        inset: 0;
        color: #8ee36a;
        clip-path: inset(48% 0 0 0);
        text-shadow: 0 0 24px rgba(142, 227, 106, 0.45);
      }

      .error-404__title {
        margin: 0;
        font-family: var(--font-display);
        font-size: clamp(1.6rem, 4vw, 2.15rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        color: #f3fceb;
      }

      .error-404__copy {
        margin: 0.9rem 0 0;
        max-width: 28rem;
        font-size: 0.98rem;
        line-height: 1.55;
        color: #8fbf7a;
      }

      .error-404__badge {
        margin-top: 1.35rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: 1px solid rgba(142, 227, 106, 0.35);
        border-radius: 999px;
        background: rgba(8, 28, 12, 0.85);
        padding: 0.45rem 0.9rem;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #8ee36a;
        box-shadow: 0 0 24px rgba(142, 227, 106, 0.18);
      }

      .error-404__badge-dot {
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 999px;
        background: #8ee36a;
        box-shadow: 0 0 10px #8ee36a;
        animation: pulse 1.6s ease-in-out infinite;
      }

      .error-404__actions {
        margin-top: 1.6rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
      }

      .error-404__btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 9.5rem;
        border-radius: 0.85rem;
        padding: 0.8rem 1.25rem;
        font-size: 0.82rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        text-decoration: none;
        transition:
          transform 0.15s ease,
          background-color 0.15s ease,
          box-shadow 0.15s ease,
          border-color 0.15s ease;
      }

      .error-404__btn:hover {
        transform: translateY(-1px);
      }

      .error-404__btn--primary {
        background: #8ee36a;
        color: #071208;
        box-shadow: 0 10px 28px rgba(142, 227, 106, 0.28);
      }

      .error-404__btn--primary:hover {
        background: #a0ec80;
      }

      .error-404__btn--ghost {
        border: 1.5px solid #8ee36a;
        color: #8ee36a;
        background: transparent;
      }

      .error-404__btn--ghost:hover {
        border-color: #a0ec80;
        color: #a0ec80;
        box-shadow: 0 0 18px rgba(142, 227, 106, 0.18);
      }

      .error-404__links {
        margin-top: 1.75rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1.25rem;
      }

      .error-404__links a {
        color: #6fad5c;
        font-size: 0.88rem;
        font-weight: 600;
        text-underline-offset: 0.2em;
      }

      .error-404__links a:hover {
        color: #8ee36a;
      }

      .error-404__mountains {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        height: clamp(120px, 22vw, 220px);
        z-index: 0;
        pointer-events: none;
      }

      @keyframes float {
        0%,
        100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(-8px);
        }
      }

      @keyframes pulse {
        0%,
        100% {
          opacity: 1;
          transform: scale(1);
        }
        50% {
          opacity: 0.55;
          transform: scale(0.85);
        }
      }

      @media (max-width: 480px) {
        .error-404__actions {
          width: 100%;
        }

        .error-404__btn {
          width: 100%;
        }
      }
    </style>
  </body>
</html>
