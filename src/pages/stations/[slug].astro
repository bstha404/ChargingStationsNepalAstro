---
import Layout from "../../layouts/Layout.astro";
import PlugBadge from "../../components/PlugBadge.astro";
import locations from "../../data/EV_Locations.json";
import {
  citySlug,
  formatLocationLine,
  stationSlug,
  type Station,
} from "../../lib/stations";
import { buildStationDescription } from "../../lib/stationDescription";
import { detectStationBrand, normalizeProvince } from "../../lib/brands";

export function getStaticPaths() {
  const stations = locations as Station[];
  return stations.map((station) => ({
    params: { slug: stationSlug(station) },
    props: { station },
  }));
}

const { station } = Astro.props as { station: Station };
const locationLine = formatLocationLine(station);
const description = buildStationDescription(station);
const brand = detectStationBrand(station);
const provinceLabel = normalizeProvince(station.province);
const mapsUrl = `https://www.google.com/maps/dir/Current+Location/${encodeURIComponent(
  station.name
)}/@${station.latitude},${station.longitude}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ElectricVehicleChargingStation",
  name: station.name,
  description,
  telephone: station.telephone || undefined,
  url: Astro.url.href,
  address: {
    "@type": "PostalAddress",
    streetAddress: station.address || undefined,
    addressLocality: station.city,
    addressRegion: provinceLabel || undefined,
    addressCountry: "NP",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: Number(station.latitude),
    longitude: Number(station.longitude),
  },
  amenityFeature: (station.amenities || []).map((name) => ({
    "@type": "LocationFeatureSpecification",
    name,
    value: true,
  })),
};
---

<Layout
  title={`${station.name} — EV Charging Station in ${station.city}, Nepal`}
  description={description}
  ogTitle={`${station.name} | EV Charging Station Nepal`}
  ogDescription={`EV charging station near you in ${station.city}: ${station.name}. View plugs and get directions.`}
  keywords={`ev charging station in ${station.city.toLowerCase()}, ev charging station nepal, ev charging station near me, ${station.name.toLowerCase()}`}
  canonical={`/stations/${stationSlug(station)}/`}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-[860px] px-4 py-8 sm:px-6 sm:py-10">
    <a
      href={`/cities/${citySlug(station.city)}/`}
      class="text-sm font-semibold text-charge no-underline hover:underline"
    >
      ← {station.city} stations
    </a>

    <header class="mt-3 mb-5">
      <p class="mb-2 text-xs font-semibold tracking-[0.08em] text-charge uppercase">
        EV Charging Station
      </p>
      <h1 class="font-display text-[clamp(1.75rem,4vw,2.75rem)] font-extrabold tracking-tight text-paper">
        {station.name}
      </h1>
      <p class="mt-2 text-sm text-muted sm:text-base">{locationLine}</p>
      {
        brand.id !== "others" && (
          <p class="mt-1.5 text-sm font-semibold text-charge uppercase">{brand.label}</p>
        )
      }
    </header>

    <div class="mb-5 flex flex-wrap gap-2">
      <a
        href={mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-charge px-4 py-2 text-sm font-bold text-ink no-underline"
      >
        Get Directions
      </a>
      {
        station.telephone && (
          <a
            href={`tel:${station.telephone}`}
            class="rounded-full border border-line bg-panel px-4 py-2 text-sm font-semibold text-paper no-underline"
          >
            Call {station.telephone}
          </a>
        )
      }
      <a
        href={`/?q=${encodeURIComponent(station.name)}`}
        class="rounded-full border border-line bg-panel px-4 py-2 text-sm font-semibold text-muted no-underline hover:text-charge"
      >
        Show on map
      </a>
    </div>


    <section class="mb-4 rounded-2xl border border-line bg-panel p-4 sm:p-5">
      <h2 class="mb-3 text-base font-bold sm:text-lg">Available plugs</h2>
      {
        station.plugs?.length ? (
          <ul class="space-y-2">
            {station.plugs.map((plug) => (
              <li>
                <PlugBadge plug={plug} size={24} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm text-muted">Plug details not listed.</p>
        )
      }
    </section>

    {
      station.amenities?.length > 0 && (
        <section class="mb-4 rounded-2xl border border-line bg-panel p-4 sm:p-5">
          <h2 class="mb-3 text-base font-bold sm:text-lg">Amenities</h2>
          <div class="flex flex-wrap gap-2">
            {station.amenities.map((amenity) => (
              <span class="rounded-full border border-line bg-ink/40 px-3 py-1 text-sm text-muted capitalize">
                {amenity}
              </span>
            ))}
          </div>
        </section>
      )
    }

    <section class="mb-4 rounded-2xl border border-line bg-panel p-4 sm:p-5">
      <h2 class="mb-3 text-base font-bold sm:text-lg">Location</h2>
      <dl class="grid gap-3 text-sm sm:grid-cols-2">
        <div>
          <dt class="text-muted">Coordinates</dt>
          <dd class="font-mono text-paper">
            {station.latitude}, {station.longitude}
          </dd>
        </div>
        <div>
          <dt class="text-muted">Vehicle type</dt>
          <dd class="text-paper capitalize">{(station.type || []).join(", ") || "car"}</dd>
        </div>
        <div>
          <dt class="text-muted">City</dt>
          <dd class="text-paper">{station.city}</dd>
        </div>
        <div>
          <dt class="text-muted">Province</dt>
          <dd class="text-paper">{provinceLabel || "—"}</dd>
        </div>
      </dl>
    </section>

    
    <section class="mb-4 rounded-2xl border border-line bg-panel p-4 sm:p-5">
      <h2 class="mb-2 text-base font-bold sm:text-lg">Description</h2>
      <p class="text-sm leading-relaxed text-muted sm:text-[0.95rem]">{description}</p>
    </section>
  </article>
</Layout>
