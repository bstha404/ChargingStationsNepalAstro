---
import Layout from "../../layouts/Layout.astro";
import locations from "../../data/EV_Locations.json";
import { formatLocationLine, stationSlug, type Station } from "../../lib/stations";
import { normalizePlugKind } from "../../lib/plugs";

const stations = (locations as Station[])
  .slice()
  .sort((a, b) => a.city.localeCompare(b.city) || a.name.localeCompare(b.name));
---

<Layout
  title={`All EV Charging Stations in Nepal (${stations.length}) | EV Charging Station Nepal`}
  description={`Complete directory of ${stations.length} EV charging stations across Nepal—find EV charging stations near me, NEA & Tata chargers, highway stops, with plugs and directions.`}
  ogTitle="All EV Charging Stations in Nepal"
  ogDescription={`Browse ${stations.length} mapped EV charging stations across Nepal with AC/DC plugs and directions.`}
  keywords="ev charging stations, ev charging station nepal, nepal ev charging station, ev charging station near me, nea ev charging station, tata ev charging station"
  canonical="/stations/"
>
  <section class="mx-auto max-w-[960px] px-6 py-12">
    <h1 class="font-display mb-3 text-[clamp(2rem,4vw,3rem)] font-extrabold tracking-tight">
      All <span class="text-gradient-green">EV Charging Stations</span> in Nepal
    </h1>
    <p class="mb-8 text-muted">
      Full listing of {stations.length} mapped EV charging stations across Nepal. Use the
      <a href="/" class="text-charge hover:underline">interactive map</a> for search and nearby sorting,
      or open a station for plugs and directions.
    </p>

    <div class="space-y-2">
      {
        stations.map((station) => {
          const kinds = [
            ...new Set(
              (station.plugs || [])
                .map((p) => normalizePlugKind(p.plug || p.icon))
                .filter((k) => k !== "other")
            ),
          ];
          return (
            <a
              href={`/stations/${stationSlug(station)}/`}
              class="flex flex-col gap-2 rounded-xl border border-line bg-panel px-4 py-3 no-underline transition-colors hover:border-charge/40 sm:flex-row sm:items-center sm:justify-between"
            >
              <div>
                <div class="font-semibold text-paper">{station.name}</div>
                <div class="text-sm text-muted">{formatLocationLine(station)}</div>
              </div>
              <div class="flex flex-wrap items-center gap-1.5 text-xs font-semibold text-charge uppercase">
                {kinds.length ? (
                  kinds.map((kind) => (
                    <span class="inline-flex items-center gap-1 rounded-md border border-charge/20 bg-charge/10 px-2 py-0.5">
                      {kind === "ccs2" ? (
                        <svg width="14" height="14" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                          <circle cx="16" cy="12.5" r="7" stroke="currentColor" stroke-width="1.6"></circle>
                          <rect x="9.2" y="21.2" width="5.2" height="6.2" rx="1.4" stroke="currentColor" stroke-width="1.4"></rect>
                          <rect x="17.6" y="21.2" width="5.2" height="6.2" rx="1.4" stroke="currentColor" stroke-width="1.4"></rect>
                        </svg>
                      ) : (
                        <svg width="14" height="14" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                          <circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="1.6"></circle>
                          <circle cx="16" cy="16" r="2.1" fill="currentColor"></circle>
                        </svg>
                      )}
                      {kind === "ccs2" ? "CCS2" : "GB/T"}
                    </span>
                  ))
                ) : (
                  <span>View</span>
                )}
              </div>
            </a>
          );
        })
      }
    </div>
  </section>
</Layout>
