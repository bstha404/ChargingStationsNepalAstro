---
import Layout from "../../layouts/Layout.astro";
import locations from "../../data/EV_Locations.json";
import { formatLocationLine, stationSlug, type Station } from "../../lib/stations";

const stations = (locations as Station[])
  .slice()
  .sort((a, b) => a.city.localeCompare(b.city) || a.name.localeCompare(b.name));
---

<Layout
  title={`All EV Charging Stations in Nepal (${stations.length})`}
  description={`Complete directory of ${stations.length} EV charging stations across Nepal with plugs, amenities, and directions.`}
  canonical="/stations/"
>
  <section class="mx-auto max-w-[960px] px-6 py-12">
    <h1 class="font-display mb-3 text-[clamp(2rem,4vw,3rem)] font-extrabold tracking-tight">
      All <span class="text-gradient-green">Charging Stations</span>
    </h1>
    <p class="mb-8 text-muted">
      {stations.length} stations indexed. Use the <a href="/" class="text-charge">interactive map</a> for
      search and nearby sorting.
    </p>

    <div class="space-y-2">
      {
        stations.map((station) => (
          <a
            href={`/stations/${stationSlug(station)}/`}
            class="flex flex-col gap-1 rounded-xl border border-line bg-panel px-4 py-3 no-underline transition-colors hover:border-charge/40 sm:flex-row sm:items-center sm:justify-between"
          >
            <div>
              <div class="font-semibold text-paper">{station.name}</div>
              <div class="text-sm text-muted">{formatLocationLine(station)}</div>
            </div>
            <div class="text-xs font-semibold text-charge uppercase">
              {(station.plugs || []).map((p) => p.type).filter(Boolean).slice(0, 2).join(" · ") ||
                "View"}
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
