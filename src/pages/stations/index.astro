---
import Layout from "../../layouts/Layout.astro";
import StationsDirectory from "../../components/StationsDirectory";
import locations from "../../data/EV_Locations.json";
import type { Station } from "../../lib/stations";

const stations = locations as Station[];
---

<Layout
  title={`All EV Charging Stations in Nepal (${stations.length}) | EV Charging Station Nepal`}
  description={`Complete directory of ${stations.length} EV charging stations across Nepal—find EV charging stations near me, NEA & Tata chargers, highway stops, with plugs and directions.`}
  ogTitle="All EV Charging Stations in Nepal"
  ogDescription={`Browse ${stations.length} mapped EV charging stations across Nepal with AC/DC plugs and directions.`}
  keywords="ev charging stations, ev charging station nepal, nepal ev charging station, ev charging station near me, nea ev charging station, tata ev charging station"
  canonical="/stations/"
>
  <section class="mx-auto max-w-[1280px] px-4 py-10 sm:px-6 sm:py-12">
    <h1 class="font-display mb-3 text-[clamp(1.75rem,4vw,3rem)] font-extrabold tracking-tight">
      All <span class="text-gradient-green">EV Charging Stations</span> in Nepal
    </h1>
    <p class="mb-6 max-w-3xl text-muted sm:mb-8">
      Browse {stations.length} mapped stations. Search by name or place, sort by nearest location, and
      filter by city, province, charger type, or brand.
    </p>

    <StationsDirectory client:load stations={stations} />
  </section>
</Layout>
