---
import Layout from "../layouts/Layout.astro";

const contactEmail = "beplovestha290@gmail.com";
/**
 * WhatsApp number in international format, digits only (Nepal starts with 977).
 * Example: 9779864691672 — replace with your real number.
 */
const whatsappNumber = "9779864691672";

const suggestionSubject = `When suggesting a station, include:
Station name and operator (if known)
Address / landmark and city
Latitude & longitude if possible
Plug types (CCS2, GB/T, AC/DC) and power
Phone number and amenities`;

const mailtoHref = `mailto:${contactEmail}?subject=${encodeURIComponent(suggestionSubject)}`;
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(suggestionSubject)}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Contact EV Charging Station Nepal",
  url: `${Astro.site || "https://evchargingstationnepal.com"}/contact/`,
  mainEntity: {
    "@type": "Organization",
    name: "EV Charging Station Nepal",
    email: contactEmail,
  },
};
---

<Layout
  title="Contact | EV Charging Station Nepal"
  description="Contact EV Charging Station Nepal to report listing errors, suggest new EV charging stations, or ask questions about the directory."
  canonical="/contact/"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-[820px] px-6 py-12">
    <p class="mb-3 text-xs font-semibold tracking-[0.08em] text-charge uppercase">Contact</p>
    <h1 class="font-display mb-3 text-[clamp(2rem,4vw,3rem)] font-extrabold tracking-tight">
      Get in <span class="text-gradient-green">touch</span>
    </h1>
    <p class="mb-8 max-w-2xl text-muted">
      Report a wrong pin, missing charger, outdated plug info, or ask a question about the directory.
    </p>

    <div class="grid gap-4 sm:grid-cols-2">
      <a
        href={mailtoHref}
        class="rounded-3xl border border-line bg-panel p-6 no-underline transition-colors hover:border-charge/40"
      >
        <div class="text-sm font-semibold tracking-wide text-charge uppercase">Email</div>
        <div class="mt-2 break-all text-xl font-bold text-paper">{contactEmail}</div>
        <p class="mt-2 text-sm text-muted">
          Opens your mail app with To and Subject filled for station suggestions.
        </p>
      </a>
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-3xl border border-line bg-panel p-6 no-underline transition-colors hover:border-charge/40"
      >
        <div class="text-sm font-semibold tracking-wide text-charge uppercase">WhatsApp</div>
        <div class="mt-2 text-xl font-bold text-paChat on WhatsAppper"></div>
        <p class="mt-2 text-sm text-muted">
          Opens WhatsApp with a pre-filled station suggestion checklist.
        </p>
      </a>
    </div>

    <div class="mt-8 rounded-3xl border border-line bg-panel p-6 text-sm leading-relaxed text-muted">
      <h2 class="mb-2 text-lg font-bold text-paper">When suggesting a station, include:</h2>
      <ul class="list-disc space-y-1 pl-5">
        <li>Station name and operator (if known)</li>
        <li>Address / landmark and city</li>
        <li>Latitude &amp; longitude if possible</li>
        <li>Plug types (CCS2, GB/T, AC/DC) and power</li>
        <li>Phone number and amenities</li>
      </ul>
    </div>
  </section>
</Layout>
