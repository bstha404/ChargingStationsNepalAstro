---
import "../styles/global.css";

interface Props {
  error?: unknown;
}

const { error } = Astro.props;
const isDev = import.meta.env.DEV;
const safeMessage =
  isDev && error instanceof Error
    ? error.message
    : "Something went wrong while loading this page. Please try again in a moment.";
---

<!doctype html>
<html lang="en-NP">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Server Error | EV Charging Station Nepal</title>
    <meta
      name="description"
      content="EV Charging Station Nepal ran into a temporary server error. Please try again shortly."
    />
    <meta name="robots" content="noindex,follow" />
    <meta name="theme-color" content="#050f05" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="error-500">
    <div class="error-500__grid" aria-hidden="true"></div>

    <main class="error-500__main">
      <img
        src="/logo.svg"
        alt="EV Charging Station Nepal"
        width="88"
        height="88"
        class="error-500__logo"
        decoding="async"
      />

      <div class="error-500__code" aria-hidden="true">
        <span class="error-500__code-outline">500</span>
        <span class="error-500__code-fill">500</span>
      </div>
      <h1 class="error-500__title">Power Surge</h1>
      <p class="error-500__copy">{safeMessage}</p>

      <div class="error-500__badge">
        <span class="error-500__badge-dot" aria-hidden="true"></span>
        Temporary Fault
      </div>

      <div class="error-500__actions">
        <a href="/" class="error-500__btn error-500__btn--primary">Go to Home</a>
        <a href="/contact/" class="error-500__btn error-500__btn--ghost">Contact Support</a>
      </div>
    </main>

    <svg
      class="error-500__mountains"
      viewBox="0 0 1440 220"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
        fill="#0a1a0c"
        d="M0 220V120L180 70L320 130L480 40L640 110L820 55L980 125L1120 65L1280 115L1440 80V220H0Z"
      ></path>
      <path
        fill="#0d2210"
        d="M0 220V155L220 110L390 160L560 95L760 150L940 105L1140 155L1320 120L1440 145V220H0Z"
      ></path>
    </svg>

    <style>
      .error-500 {
        margin: 0;
        min-height: 100vh;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #050f05;
        color: #d7f5c8;
        font-family: var(--font-body);
      }

      .error-500__grid {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(88, 174, 55, 0.07) 1px, transparent 1px),
          linear-gradient(90deg, rgba(88, 174, 55, 0.07) 1px, transparent 1px);
        background-size: 48px 48px;
        mask-image: radial-gradient(ellipse at center, black 25%, transparent 75%);
        pointer-events: none;
      }

      .error-500__main {
        position: relative;
        z-index: 1;
        width: min(100%, 40rem);
        padding: 3rem 1.5rem 8rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .error-500__logo {
        width: 5.5rem;
        height: 5.5rem;
        margin-bottom: 0.75rem;
        filter: drop-shadow(0 0 18px rgba(142, 227, 106, 0.28));
      }

      .error-500__code {
        position: relative;
        margin: 0.25rem 0 0.75rem;
        font-family: var(--font-display);
        font-size: clamp(5.5rem, 22vw, 9.5rem);
        font-weight: 800;
        line-height: 0.9;
        letter-spacing: -0.04em;
        user-select: none;
      }

      .error-500__code-outline {
        color: transparent;
        -webkit-text-stroke: 2.5px #8ee36a;
      }

      .error-500__code-fill {
        position: absolute;
        inset: 0;
        color: #8ee36a;
        clip-path: inset(48% 0 0 0);
      }

      .error-500__title {
        margin: 0;
        font-family: var(--font-display);
        font-size: clamp(1.6rem, 4vw, 2.15rem);
        font-weight: 800;
        color: #f3fceb;
      }

      .error-500__copy {
        margin: 0.9rem 0 0;
        max-width: 28rem;
        font-size: 0.98rem;
        line-height: 1.55;
        color: #8fbf7a;
      }

      .error-500__badge {
        margin-top: 1.35rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: 1px solid rgba(142, 227, 106, 0.35);
        border-radius: 999px;
        background: rgba(8, 28, 12, 0.85);
        padding: 0.45rem 0.9rem;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #8ee36a;
      }

      .error-500__badge-dot {
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 999px;
        background: #8ee36a;
        box-shadow: 0 0 10px #8ee36a;
      }

      .error-500__actions {
        margin-top: 1.6rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
      }

      .error-500__btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 9.5rem;
        border-radius: 0.85rem;
        padding: 0.8rem 1.25rem;
        font-size: 0.82rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        text-decoration: none;
      }

      .error-500__btn--primary {
        background: #8ee36a;
        color: #071208;
      }

      .error-500__btn--ghost {
        border: 1.5px solid #8ee36a;
        color: #8ee36a;
        background: transparent;
      }

      .error-500__mountains {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        height: clamp(120px, 22vw, 220px);
        z-index: 0;
        pointer-events: none;
      }
    </style>
  </body>
</html>
