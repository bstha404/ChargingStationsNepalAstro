---
import Layout from "../layouts/Layout.astro";

const faqs = [
  {
    q: "What is EV Charge Nepal?",
    a: "EV Charge Nepal is a free directory and map of electric vehicle charging stations across Nepal. You can search by name, city, or plug type, sort by nearest location, and open directions.",
  },
  {
    q: "How do I find the nearest EV charging station?",
    a: "Open the homepage map, allow location access (Use My Location), and stations will sort by distance. You can also search by city or neighborhood.",
  },
  {
    q: "What plug types are supported?",
    a: "Listings commonly include CCS2 and GB/T connectors, with AC and DC power levels when available. Use the AC / DC filters on the map page to narrow results.",
  },
  {
    q: "Is station data always accurate and up to date?",
    a: "We work to keep listings current, but charging availability, pricing, hours, and plug status can change. Always verify with the station operator before you travel.",
  },
  {
    q: "Do I need an account to use EV Charge Nepal?",
    a: "No. Searching the map, browsing cities, and viewing station pages does not require an account.",
  },
  {
    q: "Does EV Charge Nepal charge a fee?",
    a: "The website directory is free to use. Individual charging stations may charge their own fees for electricity or parking.",
  },
  {
    q: "Can I get driving directions to a charger?",
    a: "Yes. Open a station on the map or station page and choose Get Directions to launch Google Maps navigation.",
  },
  {
    q: "Which cities in Nepal have EV chargers listed?",
    a: "Coverage includes Kathmandu, Lalitpur, Pokhara, Butwal, Biratnagar, Hetauda, and many other cities and highway stops. Browse the Cities page for the full list.",
  },
  {
    q: "How is my location used?",
    a: "Location is used only in your browser to sort nearby stations. We do not require login and do not sell personal location profiles. See our Privacy Policy for details.",
  },
  {
    q: "How can I report a wrong listing or suggest a new station?",
    a: "Use the Contact page to send corrections or new station details (name, address, plugs, and coordinates if possible).",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
---

<Layout
  title="FAQ — EV Charging Stations in Nepal | EV Charge Nepal"
  description="Answers to common questions about finding EV charging stations in Nepal, plug types, directions, location privacy, and listing accuracy."
  canonical="/faq/"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-[820px] px-6 py-12">
    <p class="mb-3 text-xs font-semibold tracking-[0.08em] text-charge uppercase">Help</p>
    <h1 class="font-display mb-3 text-[clamp(2rem,4vw,3rem)] font-extrabold tracking-tight">
      Frequently Asked <span class="text-gradient-green">Questions</span>
    </h1>
    <p class="mb-10 max-w-2xl text-muted">
      Quick answers about using EV Charge Nepal to find electric vehicle chargers across the country.
    </p>

    <div class="space-y-3">
      {
        faqs.map((item) => (
          <details class="group rounded-2xl border border-line bg-panel px-5 py-4 open:border-charge/30">
            <summary class="cursor-pointer list-none font-semibold text-paper marker:content-none [&::-webkit-details-marker]:hidden">
              <span class="flex items-start justify-between gap-4">
                <span>{item.q}</span>
                <span class="text-charge transition-transform group-open:rotate-45">+</span>
              </span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-muted">{item.a}</p>
          </details>
        ))
      }
    </div>

    <p class="mt-10 text-sm text-muted">
      Still need help? <a href="/contact/" class="font-semibold text-charge hover:underline">Contact us</a>
      or read the <a href="/privacy/" class="font-semibold text-charge hover:underline">Privacy Policy</a>.
    </p>
  </section>
</Layout>
